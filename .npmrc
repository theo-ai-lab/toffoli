# Toffoli — supply-chain hygiene for a mostly-unattended deploy.
#
# Cooldown: refuse to install any dependency version younger than 7 days. 8 of 10 recent npm
# supply-chain attacks had sub-week exploitation windows (Socket, 2026); a cooldown protects you
# precisely during the window you are NOT watching, at zero ongoing cost. Requires npm >= 11.10.0;
# the unit is DAYS. Dependabot/Renovate SECURITY patches are excluded from the cooldown separately.
min-release-age=7

# Enforce the package.json `engines` constraint at install time (by default it only warns), so CI and
# local installs actually use the pinned npm. CI additionally pins npm via actions/setup-node.
engine-strict=true

# Run lifecycle scripts only for vetted packages; CI uses `npm ci --ignore-scripts` (see workflow).
