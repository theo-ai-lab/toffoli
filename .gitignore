# dependencies (here node_modules is a symlink to a shared install — no trailing slash,
# so the symlink itself is matched and can never be accidentally staged, not just a real dir)
node_modules

# secrets
.env
.env.local

# build / cache
dist/
*.tsbuildinfo
.DS_Store
logs/

# local-only
.private/

# local-only captured runs; never committed (see dataset/PROVENANCE.md)
dataset/captured.jsonl
dataset/*.captured.jsonl

# generated telemetry
traces/

# Lean build artifacts (the formal proof; source is tracked, build cache is not)
formal/.lake/
