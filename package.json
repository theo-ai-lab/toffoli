{
  "name": "toffoli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The undo layer for AI agents — classifies every agent action reversible / compensable / irreversible, plans the restitution, and escalates only what truly can't be undone. Measured as an eval.",
  "keywords": [
    "ai-agents",
    "agent-safety",
    "undo",
    "restitution",
    "reversibility",
    "compensating-transaction",
    "eval",
    "guardrails"
  ],
  "author": "theo-ai-lab",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "eval": "tsx lib/engine/eval.ts",
    "calibrate": "tsx lib/engine/calibrate.ts",
    "demo": "tsx lib/demo.ts",
    "recover": "tsx lib/exec/recover.ts",
    "recover:fs": "tsx lib/exec/fs-recover.ts",
    "safe": "tsx lib/runtime/demo.ts",
    "oracle:demo": "tsx lib/runtime/oracle-demo.ts",
    "search": "tsx lib/agent/counterexample-demo.ts",
    "trace": "tsx lib/trace/demo.ts",
    "agent": "tsx lib/agent/index.ts",
    "agent:demo": "tsx lib/agent/index.ts",
    "mcp": "tsx lib/mcp/server.ts",
    "sql-recover": "NODE_NO_WARNINGS=1 tsx lib/exec/sql-world.ts",
    "gate": "tsx lib/gate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.0.1",
    "fast-check": "^4.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
